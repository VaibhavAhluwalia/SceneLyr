{
  "name": "scenelyr",
  "version": "0.1.0",
  "private": true,
  "description": "The semantic visual layer for AI agents",
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": { "node": ">=20", "npm": ">=11.6.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
